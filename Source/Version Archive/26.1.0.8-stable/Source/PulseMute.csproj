<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>PulseMute.ico</ApplicationIcon>
    <AssemblyName>PulseMute Main</AssemblyName>
    <Product>PulseMute Main</Product>
    <Version>26.1.0.8-stable</Version>
    <FileVersion>26.1.0.8</FileVersion>
    <InformationalVersion>26.1.0.8-stable</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <Compile Remove="ControllerProtocolTests.cs" />
    <EmbeddedResource Include="PulseMute-professional.ico" LogicalName="PulseMuteProfessional.ico" />
    <EmbeddedResource Include="PulseMute-professional.png" LogicalName="PulseMuteProfessional.png" />
    <EmbeddedResource Include="PulseMute-logo-shadow.ico" LogicalName="PulseMuteLogoShadow.ico" />
    <EmbeddedResource Include="PulseMute-logo-shadow.png" LogicalName="PulseMuteLogoShadow.png" />
    <EmbeddedResource Include="PulseMute-logo-rounded.ico" LogicalName="PulseMuteLogoRounded.ico" />
    <EmbeddedResource Include="PulseMute-logo-rounded.png" LogicalName="PulseMuteLogoRounded.png" />
    <EmbeddedResource Include="PulseMute-logo-outline.ico" LogicalName="PulseMuteLogoOutline.ico" />
    <EmbeddedResource Include="PulseMute-logo-outline.png" LogicalName="PulseMuteLogoOutline.png" />
    <EmbeddedResource Include="PulseMute-control-muted.png" LogicalName="PulseMuteControlMuted.png" />
    <EmbeddedResource Include="PulseMute-control-live.png" LogicalName="PulseMuteControlLive.png" />
  </ItemGroup>
</Project>

{
  "folders": [
    {
      "name": "PulseMute Beta",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "Main source/Version Archive": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build PulseMute Beta",
        "type": "shell",
        "command": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\Main source\\build.ps1"],
        "group": "build",
        "problemMatcher": "$msCompile"
      },
      {
        "label": "Test PulseMute Beta",
        "type": "shell",
        "command": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\Main source\\test-controller.ps1"],
        "group": "test"
      }
    ]
  }
}

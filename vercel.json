{
  "headers": [
    {
      "source": "/downloads/PulseMute.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=PulseMute.exe"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
